# Copy to .env and fill in real values. .env is gitignored.
# If these are left unset, the tests fall back to data/credentials.json.

# API login used by APIUtils (utils/api_base.py)
API_USER_EMAIL=
API_USER_PASSWORD=

# Primary UI login user for the parametrized e2e test (test_web_api.py)
UI_USER_EMAIL=
UI_USER_PASSWORD=

# Optional second UI user (both must be set to add the extra parametrized case)
UI_USER_EMAIL_2=
UI_USER_PASSWORD_2=